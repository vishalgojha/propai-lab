# Pin the OS line. The floating `python:3.11-slim` tag moved to Debian 13,
# whose Chromium dependency graph is substantially heavier and caused fresh
# Coolify builds to be killed while regenerating the font cache. Debian 12
# remains the known-good image line for this service.
FROM python:3.11-slim-bookworm AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    AGENT_BROWSER_ARGS="--no-sandbox,--disable-dev-shm-usage" \
    AGENT_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium

WORKDIR /app

# Agent Browser is configured to launch Debian's /usr/bin/chromium. Do not run
# `agent-browser install`: that downloads a second private Chrome bundle into
# every API and worker image without changing the configured runtime browser.
RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends build-essential ca-certificates chromium nodejs \
  && npm install --global agent-browser \
  && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Keep the building-enrichment worker runnable even when Coolify builds this
# Dockerfile directly and does not pass the compose build argument. The
# dependency is isolated at runtime by provider availability, so API behavior
# remains unchanged while the dedicated worker no longer silently lacks it.
ARG INSTALL_BUILDING_DISCOVERY=true
COPY requirements.discovery.txt ./
RUN if [ "$INSTALL_BUILDING_DISCOVERY" = "true" ]; then \
      pip install --no-cache-dir -r requirements.discovery.txt; \
      PLAYWRIGHT_BROWSERS_PATH=/ms-playwright python -m playwright install chromium; \
      python -c "import crawl4ai; print('Crawl4AI import OK')"; \
    fi

# Keep Crawl4AI's Playwright browser in the image instead of relying on a
# runtime home-directory cache, which is absent in fresh worker containers.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

COPY . .

# Keep source-revision mistakes from becoming opaque runtime import errors.
# `building_quality.py` is imported by storage/supabase.py and must be part of
# the API build context (it was missing from an earlier Coolify build).
RUN test -f /app/building_quality.py \
    || (echo "BUILD FAILED: building_quality.py is missing from the API source revision" && exit 1)

# Smoke-test: compile only API Python files so syntax errors crash the build,
# not the production container.
RUN python3 -m compileall -q routers/ storage/ agents/ knowledge/ \
    && python3 -m py_compile app.py \
    && python3 -m py_compile extraction.py \
    && python3 -m py_compile building_enrichment_worker.py \
    && python3 -m py_compile semantic_embeddings.py \
    && python3 -m py_compile semantic_embedding_worker.py \
    && python3 -m py_compile matching/requirement_listing_matcher.py matching/service.py matching/worker.py \
    && python3 -m py_compile ai_extraction.py \
    && python3 -m py_compile location.py \
    && python3 -m py_compile llm.py \
    && python3 -c "from routers import ai_chat, infra, search, workspace; print('router imports OK')" \
    || (echo "BUILD FAILED: syntax or import error" && exit 1)

RUN mkdir -p /data

EXPOSE 8000

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--timeout-keep-alive", "5"]
