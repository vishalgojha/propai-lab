FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends build-essential ca-certificates curl gnupg \
  && mkdir -p /etc/apt/keyrings \
  && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
  && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_24.x nodistro main" > /etc/apt/sources.list.d/nodesource.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends nodejs \
  && npm install --global agent-browser \
  && agent-browser install \
  && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Smoke-test: compile only API Python files so syntax errors crash the build,
# not the production container.
RUN python3 -m compileall -q routers/ storage/ agents/ knowledge/ \
    && python3 -m py_compile app.py \
    && python3 -m py_compile extraction.py \
    && python3 -m py_compile building_enrichment_worker.py \
    && python3 -m py_compile ai_extraction.py \
    && python3 -m py_compile location.py \
    && python3 -m py_compile llm.py \
    && python3 -c "from routers import ai_chat, infra, search, workspace; print('router imports OK')" \
    || (echo "BUILD FAILED: syntax or import error" && exit 1)

RUN mkdir -p /data

EXPOSE 8000

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--timeout-keep-alive", "5"]
