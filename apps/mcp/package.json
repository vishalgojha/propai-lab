{
  "name": "mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PropAI remote MCP server for real estate listings and market intelligence",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --experimental-test-module-mocks --test dist/*.test.js",
    "start": "node dist/server.js",
    "dev": "node --loader ts-node/esm src/server.ts",
    "stdio": "node dist/stdio.js",
    "dev:stdio": "node --loader ts-node/esm src/stdio.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@supabase/supabase-js": "2.119.1",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "jsonwebtoken": "9.0.3",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "ts-node": "10.9.2",
    "typescript": "7.0.2"
  },
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": "22.23.5",
    "npm": "10.9.9"
  }
}
