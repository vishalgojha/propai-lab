FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

RUN python3 -m py_compile tenant_boundary_repair_worker.py extraction.py storage/supabase.py

CMD ["python3", "tenant_boundary_repair_worker.py"]
