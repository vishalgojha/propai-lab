{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace",
      "model": {
        "primary": "openrouter/openrouter/free",
        "fallbacks": ["openrouter/deepseek/deepseek-chat"]
      },
      "models": {
        "openrouter/openrouter/free": {},
        "openrouter/deepseek/deepseek-chat": {}
      },
      "maxConcurrent": 1
    }
  },
  "plugins": {
    "allow": ["codex", "diagnostics-otel"]
  }
}
